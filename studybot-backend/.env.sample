DATABASE_URL=

JWT_SECRET_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=

# Comma-separated frontend origin(s) allowed by CORS.
# Dev example:  http://127.0.0.1:5500,http://localhost:5500
# Prod example: https://your-frontend.example.com
ALLOWED_ORIGINS=

# Comma-separated MIME types accepted for upload.
# e.g. application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain
ALLOWED_MIME_TYPES=

JINA_API_KEY=

GROQ_API_KEY=
GROQ_MODEL_NAME=

# ============================================================
# OPTIONAL — safe defaults exist in config.py, override only if needed.
# ============================================================

MAX_FILE_SIZE_BYTES=10485760        # 10 MB
MAX_STORAGE_NAME_LEN=100
MAX_ACTIVE_DOCUMENTS=3
MAX_BIN_DOCUMENTS=5
RECYCLE_BIN_RETENTION_DAYS=7

CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CHAT_TOP_K=5
CHAT_MAX_COSINE_DISTANCE=0.8

HYBRID_MODE_ENABLED=false

SQL_ECHO=false                      # true in dev if you want raw SQL logged

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Unused in current code (sentence-transformers can use it for gated HF
# models) — keep only if you actually need it, otherwise safe to delete.
HF_TOKEN=